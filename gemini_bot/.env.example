# Telegram Bot Token от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Keys от Google AI Studio (https://aistudio.google.com/)
# Можно указать несколько ключей через запятую для БЕЗЛИМИТНОГО режима (авто-ротация при 429)
GEMINI_API_KEYS=your_first_gemini_api_key_here,your_second_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Модель по умолчанию: gemini-3.8-flash, gemini-3.1-pro-preview, gemini-flash-latest, gemini-pro-latest
DEFAULT_MODEL=gemini-3.8-flash
ADMIN_ID=123456789
AGENT_ACCESS_MODE=admin_only

# Системный промпт (характер и инструкции для бота)
SYSTEM_PROMPT=Ты — умный, эрудированный и дружелюбный персональный AI-ассистент в Telegram на базе Google Gemini. Твоя задача — оперативно, точно и понятно помогать пользователю в решении любых задач: в коде, учебе, работе, анализе текстов и генерации идей. Отвечай на языке собеседника, сохраняй нить диалога и используй красивое форматирование.
