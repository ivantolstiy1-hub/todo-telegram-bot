# Telegram Bot Token от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Keys от Google AI Studio (https://aistudio.google.com/)
# Можно указать несколько ключей через запятую для БЕЗЛИМИТНОГО режима (авто-ротация при 429)
GEMINI_API_KEYS=your_first_gemini_api_key_here,your_second_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Модель по умолчанию: auto-hermes, gemini-3.5-flash, deepseek-reasoner, claude-3-5-sonnet, gpt-4o
DEFAULT_MODEL=auto-hermes
ADMIN_ID=8173946372
AGENT_ACCESS_MODE=admin_only

# Мульти-LLM провайдеры для Агента Гермес (Опционально, подключайте по мере необходимости):
# 1. OpenRouter (Единый ключ для сотен моделей: Nous Hermes 3, Claude 3.5, DeepSeek R1, GPT-4o)
OPENROUTER_API_KEY=
# 2. DeepSeek API напрямую (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
# 3. OpenAI API напрямую (https://platform.openai.com/)
OPENAI_API_KEY=
# 4. Anthropic Claude API напрямую (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Нейросети генерации и монтажа видео (Video AI):
# 5. Fal.ai (Универсальный видео-шлюз: Kling 1.5, Luma Ray 2, Minimax Hailuo)
FAL_KEY=
# 6. Luma Dream Machine напрямую (https://lumalabs.ai/dream-machine/api)
LUMA_API_KEY=
# 7. Runway Gen-3 Alpha напрямую (https://runwayml.com/)
RUNWAY_API_KEY=

# Системный промпт (характер и инструкции для бота)
SYSTEM_PROMPT=Ты — умный, эрудированный и дружелюбный персональный AI-ассистент в Telegram на базе Google Gemini и Агента Гермес. Твоя задача — оперативно, точно и понятно помогать пользователю в решении любых задач: в коде, учебе, работе, анализе текстов и генерации идей. Отвечай на языке собеседника, сохраняй нить диалога и используй красивое форматирование.
